	"version": "0.2.0",
	"configurations": [
		{
			"name": "(no arguments)",
			"console": "integratedTerminal",
			"type": "debugpy",
			"request": "launch",
			"module": "scribe",
			"args": [
				// Test for missing required parameter `mode`.
				// Expect a missing parameter error and help message.
			]
		},
		{
			"name": "(help)",
			"console": "integratedTerminal",
			"type": "debugpy",
			"request": "launch",
			"module": "scribe",
			"args": ["-h"]
		},
		{
			"name": "Generate",
			"console": "integratedTerminal",
			"type": "debugpy",
			"request": "launch",
			"module": "scribe",
			"args": [
				"--settings", "scribe.json",
				"--log-file-path", "scribe.generator.log",
				"generate",
				"--config", "scribe.generator.json"
			]
		},
		{
			"name": "Upload",
			"console": "integratedTerminal",
			"type": "debugpy",
			"request": "launch",
			"module": "scribe",
			"args": [
				"--settings", "scribe.json",
				"--log-file-path", "scribe.uploader.log",
				"upload",
				"--config", "scribe.uploader.json",
				"--environment", "local"
			]
		}
	]
}
