	"version": "0.2.0",
	"configurations": [
		{
			"name": "Wiki: Launch Debug",
			"console": "integratedTerminal",
			"type": "debugpy",
			"request": "launch",
			"module": "app",
			"args": [
				"--settings",
				"${workspaceFolder}\\app_settings.json"
			]
		},
		{
			"name": "Wiki-Bot: Launch Debug",
			"type": "debugpy",
